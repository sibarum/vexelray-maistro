<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray</groupId>
    <artifactId>vexelray-maistro-parent</artifactId>
    <version>0.1.2</version>
    <packaging>pom</packaging>

    <name>vexelray-maistro-parent</name>
    <description>
        Maistro, as modules: the application (vexelray-maistro), and what it needs to know per operating system —
        where the Claude Code CLI is installed — behind ClaudeInstall (vexelray-maistro-api), with one
        vexelray-maistro-&lt;os&gt; module per OS.
    </description>

    <modules>
        <module>vexelray-maistro-api</module>
        <!-- The OS halves; the application's OS-activated profiles add one. -->
        <module>vexelray-maistro-windows</module>
        <module>vexelray-maistro-linux</module>
        <module>vexelray-maistro-macos</module>
        <module>vexelray-maistro</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-maistro-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-maistro-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-maistro-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.vexelray</groupId>
                <artifactId>vexelray-maistro-macos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Pinned for every module: Maven's built-in default predates JUnit 5 and runs no tests, silently. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- `mvn exec:exec` from here runs the application: declared skipped, with a valid executable, so the
                 aggregator and the small modules never launch anything; vexelray-maistro turns it back on. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skip>true</skip>
                    <executable>${java.home}/bin/java</executable>
                </configuration>
            </plugin>
            <!-- Platform-specific code only in -windows, -linux and -macos modules: vexelray-build's isolate goal fails
                 the build on any outside them (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2</version>
                <executions>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
